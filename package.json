{
  "name": "codevault",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "test": "npm run build && node --experimental-strip-types --test --test-concurrency=2 tests/*.test.mjs",
    "test:live": "npm run build && node scripts/smoke-live.mjs",
    "test:upgrade": "npm run build && node --test --test-concurrency=1 tests/upgrade/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "1.56.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
}
